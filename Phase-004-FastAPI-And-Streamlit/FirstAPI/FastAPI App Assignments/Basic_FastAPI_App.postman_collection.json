{
  "info": {
    "_postman_id": "28eb3687-88ca-45c7-b2b8-98a467ea0144",
    "name": "Basic FastAPI App",
    "description": "Creates five items, verifies the list total, and confirms that a sixth item is rejected.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "1 - Create Laptop",
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Created item 1', function () {", "  pm.response.to.have.status(201);", "  pm.expect(pm.response.json().id).to.eql(1);", "});"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Laptop\",\n  \"description\": \"Development computer\"\n}"}, "url": "{{baseUrl}}/items"}
    },
    {
      "name": "2 - Create Keyboard",
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Created item 2', function () {", "  pm.response.to.have.status(201);", "  pm.expect(pm.response.json().id).to.eql(2);", "});"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Keyboard\"\n}"}, "url": "{{baseUrl}}/items"}
    },
    {
      "name": "3 - Create Mouse",
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Created item 3', function () {", "  pm.response.to.have.status(201);", "  pm.expect(pm.response.json().id).to.eql(3);", "});"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Mouse\"\n}"}, "url": "{{baseUrl}}/items"}
    },
    {
      "name": "4 - Create Monitor",
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Created item 4', function () {", "  pm.response.to.have.status(201);", "  pm.expect(pm.response.json().id).to.eql(4);", "});"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Monitor\"\n}"}, "url": "{{baseUrl}}/items"}
    },
    {
      "name": "5 - Create Headphones",
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Created item 5', function () {", "  pm.response.to.have.status(201);", "  pm.expect(pm.response.json().id).to.eql(5);", "});"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Headphones\"\n}"}, "url": "{{baseUrl}}/items"}
    },
    {
      "name": "6 - Verify Five Items",
      "event": [{"listen": "test", "script": {"exec": ["pm.test('List contains exactly five items', function () {", "  pm.response.to.have.status(200);", "  const data = pm.response.json();", "  pm.expect(data.total).to.eql(5);", "  pm.expect(data.maximum).to.eql(5);", "  pm.expect(data.items).to.have.lengthOf(5);", "});"]}}],
      "request": {"method": "GET", "header": [], "url": "{{baseUrl}}/items"}
    },
    {
      "name": "7 - Reject Sixth Item",
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Sixth item is rejected', function () {", "  pm.response.to.have.status(409);", "});"]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"name\": \"Sixth item\"\n}"}, "url": "{{baseUrl}}/items"}
    }
  ]
}
