# Copy to .env (copy .env.example .env) and edit. .env is git-ignored — never commit real keys.

# Which model answers: mock (no key, predefined answers) | openai | ollama (local)
LLM_PROVIDER="mock"

# OpenAI — used when LLM_PROVIDER=openai
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Ollama (local, free) — used when LLM_PROVIDER=ollama; first run: ollama pull qwen2.5:0.5b
OLLAMA_MODEL="qwen2.5:0.5b"
OLLAMA_BASE_URL="http://localhost:11434"

# Answer style and robustness
LLM_TEMPERATURE="0.2"
MAX_RETRIES="1"
LLM_TIMEOUT_SECONDS="60"

# LangSmith tracing (optional, hosted) — needs an account and an API key from smith.langchain.com
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ai-learning-assistant"

LOG_LEVEL="INFO"
